MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=nutrition-staff

# Base URL the browser uses for API calls. Same-origin API routes need just "/api";
# only change this if the backend is ever split out to a different origin.
NEXT_PUBLIC_API_BASE_URL=/api

# Secret used to sign/verify JWTs. Generate your own (e.g. `openssl rand -hex 32`) — never reuse the same value across environments.
JWT_SECRET=<random-hex-secret>

# nutrition-client's origin — publishRevalidation() posts to
# <NUTRITION_CLIENT_URL>/api/revalidate after a successful write, so its
# cached public content is invalidated on demand instead of only on its
# fallback interval. Both this and REVALIDATE_SECRET are optional: if
# either is unset, publishRevalidation() no-ops rather than failing the
# write that triggered it (e.g. local development with no nutrition-client
# instance running).
NUTRITION_CLIENT_URL=http://localhost:4123

# Shared secret authenticating calls to nutrition-client's /api/revalidate
# — must match the REVALIDATE_SECRET nutrition-client is configured with.
# Generate your own (e.g. `openssl rand -hex 32`) — never reuse the same
# value across environments.
REVALIDATE_SECRET=<random-hex-secret>
