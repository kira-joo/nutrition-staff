MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB=nutrition-staff

# Base URL the browser uses for API calls. Same-origin API routes need just "/api";
# only change this if the backend is ever split out to a different origin.
NEXT_PUBLIC_API_BASE_URL=/api

# Secret used to sign/verify JWTs. Generate your own (e.g. `openssl rand -hex 32`) — never reuse the same value across environments.
JWT_SECRET=<random-hex-secret>
